RAIL_API_BASE_URL=https://indian-railway-api.onrender.com
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILKIT_API_KEY=your_railkit_api_key_here

# Optional Free-Tier LLM Accelerators for Express AI Intent Bar (/api/ai-intent)
# Works out-of-the-box in <5ms with the built-in instant deterministic parser;
# add either key below to enable free-form / Hinglish LLM extraction:
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional OpenAI-Compatible Provider for Dash AI Copilot (/api/copilot)
# Falls back automatically to the built-in corridor heuristic engine when omitted:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
COPILOT_RATE_LIMIT=20
